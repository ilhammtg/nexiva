# ─── App ───────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8080
APP_SECRET_KEY=           # WAJIB: min 32 karakter

# ─── Database (PostgreSQL) ──────────────────────────────────
# Di Docker: DB_HOST=postgres
# Di lokal:  DB_HOST=localhost
DB_HOST=postgres
DB_PORT=5432
DB_NAME=isp_registration
DB_USER=isp_dev
DB_PASSWORD=              # WAJIB
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=15

# ─── Redis ─────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=           # set jika Redis punya auth
REDIS_DB=0

# ─── JWT ───────────────────────────────────────────────────
JWT_SECRET=               # WAJIB: min 32 karakter
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=7

# ─── Mikrotik ──────────────────────────────────────────────
MIKROTIK_HOST=
MIKROTIK_PORT=443
MIKROTIK_USER=admin
MIKROTIK_PASSWORD=
MIKROTIK_PPPOE_PREFIX=ISP

# ─── OLT ZTE ───────────────────────────────────────────────
OLT_SSH_HOST=
OLT_SSH_PORT=22
OLT_SSH_USER=admin
OLT_SSH_PASSWORD=
OLT_SSH_TIMEOUT_SEC=30

# ─── NATS ──────────────────────────────────────────────────
NATS_URL=nats://nats:4222

# ─── Notification ──────────────────────────────────────────
NOTIF_WEBHOOK_URL=
NOTIF_ENABLED=true

# ─── Upload ────────────────────────────────────────────────
UPLOAD_MAX_SIZE_MB=5
UPLOAD_PATH=./uploads

# ─── Provisioning ──────────────────────────────────────────
PROVISIONING_TIMEOUT_SEC=30
PROVISIONING_MAX_RETRY=3
PROVISIONING_RETRY_INTERVAL_SEC=10
